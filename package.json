{
	"name": "font-flux-js",
	"version": "2.9.1",
	"description": "Convert fonts to JSON, make edits, then convert them back!",
	"main": "dist/font-flux-js.js",
	"types": "index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"import": "./dist/font-flux-js.js"
		},
		"./schema": "./font-flux.schema.json"
	},
	"files": [
		"dist/",
		"index.d.ts",
		"font-flux.schema.json",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"test:visual": "node test/visual/server.js",
		"test:demo": "node scripts/verify-demo.mjs",
		"test:consumers": "npm run build && node scripts/verify-consumers.mjs",
		"test:large": "node scripts/verify-large-font.mjs",
		"build": "vite build",
		"demo:dev": "vite --config demo/vite.config.js",
		"demo:build": "vite build --config demo/vite.config.js",
		"site:build": "npm run demo:build && npm run docs:build",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:preview": "vitepress preview docs",
		"lint": "biome lint",
		"format": "biome lint --write",
		"release": "node scripts/release.mjs"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mattlag/Font-Flux-JS.git"
	},
	"keywords": [
		"font",
		"opentype",
		"truetype",
		"woff",
		"woff2",
		"ttf",
		"otf",
		"ttc",
		"otc",
		"json",
		"parser",
		"converter"
	],
	"author": "Matt LaGrandeur",
	"license": "GPL-3.0-only",
	"bugs": {
		"url": "https://github.com/mattlag/Font-Flux-JS/issues"
	},
	"homepage": "https://www.glyphrstudio.com/fontfluxjs/",
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@playwright/test": "1.63.0",
		"ajv": "8.20.0",
		"harfbuzzjs": "1.6.1",
		"typescript": "7.0.2",
		"vite": "^8.0.0",
		"vitepress": "^2.0.0-alpha.18",
		"vitest": "4.1.11",
		"yaml": "2.9.0"
	},
	"dependencies": {
		"brotli-wasm": "^3.0.1",
		"pako": "^2.1.0"
	},
	"allowScripts": {
		"esbuild@0.21.5": true
	}
}
